<!--pages/profile/profile.wxml-->
<view class="page">
  <!-- 吸顶导航 -->
  <nav-bar title="我的" fixed="{{true}}" placeholder="{{true}}">
    <view slot="right" class="nav-btn hover-opacity" bindtap="goSettings">
      <text class="nav-icon">⚙️</text>
    </view>
  </nav-bar>

  <!-- 个人信息卡片（毛玻璃+渐变） -->
  <view class="profile-card">
    <view class="card-bg">
      <view class="card-blur"></view>
      <view class="card-deco d1"></view>
      <view class="card-deco d2"></view>
      <view class="card-deco d3"></view>
    </view>
    <view class="card-content">
      <view class="card-left">
        <view class="avatar-wrap" bindtap="onLogin">
          <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="avatar-edit" wx:if="{{userInfo}}">📷</view>
        </view>
        <view class="user-info" wx:if="{{userInfo}}">
          <text class="user-name">{{userInfo.nickName}}</text>
          <text class="user-id">ID: {{openid || '********'}}</text>
        </view>
        <view class="user-info" wx:else bindtap="onLogin">
          <text class="user-name">点击登录</text>
          <text class="user-id">登录后享受更多功能</text>
        </view>
      </view>
      <view class="vip-badge" bindtap="goVip">
        <text class="vip-icon">👑</text>
        <text>开通VIP</text>
      </view>
    </view>
    <!-- 统计 -->
    <view class="stats-row">
      <view class="stat-item" bindtap="seeMyWorks">
        <text class="stat-num">{{stats.works}}</text>
        <text class="stat-label">作品</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.favorites}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.likes}}</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.following}}</text>
        <text class="stat-label">关注</text>
      </view>
    </view>
  </view>

  <!-- 我的作品瀑布流 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📷 我的作品</text>
      <view class="section-tabs">
        <text class="tab {{worksTab === 'all' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="all">全部</text>
        <text class="tab {{worksTab === 'liked' ? 'active' : ''}}" bindtap="switchWorksTab" data-tab="liked">收藏</text>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view wx:if="{{worksLoading}}" class="works-skeleton">
      <view class="ws-col">
        <view class="ws-card skeleton" wx:for="{{3}}" wx:key="*this" style="height: {{200 + index * 50}}rpx;"></view>
      </view>
      <view class="ws-col">
        <view class="ws-card skeleton" wx:for="{{3}}" wx:key="*this" style="height: {{250 + index * 40}}rpx;"></view>
      </view>
    </view>

    <!-- 瀑布流 -->
    <view wx:elif="{{myWorksLeft.length > 0}}" class="works-waterfall">
      <view class="works-col">
        <view class="works-card" wx:for="{{myWorksLeft}}" wx:key="id" bindtap="viewResult" data-id="{{item.id}}">
          <image class="works-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" style="height: {{item.imgHeight}}rpx;" />
          <view class="works-info">
            <text class="works-name ellipsis">{{item.templateName}}</text>
            <text class="works-time">{{item.timeAgo}}</text>
          </view>
          <view class="works-status {{item.status}}">
            <text wx:if="{{item.status === 'completed'}}">✓</text>
            <text wx:elif="{{item.status === 'processing'}}">⏳</text>
          </view>
        </view>
      </view>
      <view class="works-col">
        <view class="works-card" wx:for="{{myWorksRight}}" wx:key="id" bindtap="viewResult" data-id="{{item.id}}">
          <image class="works-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" style="height: {{item.imgHeight}}rpx;" />
          <view class="works-info">
            <text class="works-name ellipsis">{{item.templateName}}</text>
            <text class="works-time">{{item.timeAgo}}</text>
          </view>
          <view class="works-status {{item.status}}">
            <text wx:if="{{item.status === 'completed'}}">✓</text>
            <text wx:elif="{{item.status === 'processing'}}">⏳</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-emoji">📭</text>
      <text class="empty-text">还没有作品</text>
      <text class="empty-hint">快去制作你的第一张AI写真吧</text>
      <view class="empty-btn" bindtap="goCreate">去创作 ✨</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" wx:for="{{menuItems}}" wx:key="type" bindtap="onMenuTap" data-type="{{item.type}}">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-text">{{item.name}}</text>
        <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <view class="menu-vip" wx:if="{{item.vip}}">VIP</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version">妙鸭 v1.0.0 · 即梦AI驱动</view>
  <view class="safe-area-bottom" style="height: 20rpx;"></view>
</view>
