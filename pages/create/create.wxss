/* pages/create/create.wxss */
/* 
 * 视觉层次：8rpx 基线网格
 * 间距分层：一级48 二级24 三级16 四级8
 * 圆角分层：最大48 大32 中24 小16 最小8 圆形50%
 */

.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 280rpx; /* 为底部栏留空间 */
}

.nav-tip {
  font-size: 34rpx;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
}

/* ===== 步骤指示器 ===== */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx; /* 二级留白 */
  background: #fff;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx; /* 四级留白 */
  opacity: 0.35;
  transition: all 0.4s;
}

.step.active { opacity: 1; }

.step-num {
  width: 48rpx; /* 8的倍数 */
  height: 48rpx;
  border-radius: 50%; /* 圆形 */
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.4s;
}

.step.active .step-num {
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255,107,157,0.35);
}

.step.done .step-num {
  background: #00b894;
  color: #fff;
}

.step-text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.step.active .step-text {
  color: #FF6B9D;
  font-weight: 600;
}

.step-line {
  width: 80rpx; /* 8的倍数 */
  height: 3rpx;
  background: #e0e0e0;
  margin: 0 12rpx 24rpx; /* 对齐文字下方 */
  transition: background 0.4s;
}

.step-line.active {
  background: linear-gradient(90deg, #00b894, #55efc4);
}

/* ===== 5.3 进度指示区 ===== */
.progress-section {
  padding: 16rpx 24rpx 16rpx; /* 三级留白 */
  background: #fff;
  margin-bottom: 16rpx;
}

/* 进度条高度 8rpx */
.progress-bar-8rpx {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx; /* 四级留白 */
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B9D, #C44FE2);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
}

.progress-text.good { color: #fdcb6e; }
.progress-text.great { color: #00b894; }

/* ===== 5.2 照片网格区 ===== */
.photo-grid-section {
  padding: 0 24rpx;
}

.upload-label {
  display: flex;
  align-items: center;
  gap: 8rpx; /* 四级留白 */
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.label-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FF6B9D;
}

.label-dot.warn { background: #fdcb6e; }

/* 正面照卡片 */
.front-card {
  width: 100%;
  height: 320rpx;
  background: #fff;
  border-radius: 16rpx; /* 小圆角 — 照片网格项 */
  border: 3rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.front-icon { font-size: 56rpx; }
.front-hint { font-size: 24rpx; color: #999; }

.front-img { width: 100%; height: 100%; }

.front-replace {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(8px);
  color: #fff;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
}

/* 3列网格 — 宽高比 1:1 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 三列等宽 */
  gap: 16rpx; /* 三级留白 */
}

.photo-cell {
  position: relative;
  aspect-ratio: 1; /* 宽高比 1:1 */
  border-radius: 16rpx; /* 小圆角 */
  overflow: hidden;
  background: #fff;
  border: 2rpx solid #f0f0f0;
}

.photo-img {
  width: 100%;
  height: 100%;
}

/* 删除按钮 — 圆形红底白叉，直径 40rpx */
.photo-delete {
  position: absolute;
  top: 8rpx; /* 偏移 8rpx */
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(225,112,85,0.85);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  z-index: 2;
}

/* 5.4 质量反馈遮罩 */
.photo-quality-mask {
  position: absolute;
  inset: 0;
  background: rgba(255,0,0,0.1);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8rpx;
}

.quality-tag {
  background: rgba(225,112,85,0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx; /* 最小圆角 */
  padding: 2rpx 12rpx;
}

/* 添加照片占位项 */
.photo-cell.add {
  border: 3rpx dashed #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.add-icon {
  font-size: 48rpx;
  color: #ccc;
}

/* 拍摄建议卡片 */
.tips-card {
  margin: 24rpx 24rpx 0; /* 二级留白 */
  background: #fff;
  padding: 24rpx; /* 二级留白 */
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx; /* 三级留白 */
}

.tips-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.tip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  padding: 8rpx 10rpx;
  border-radius: 8rpx; /* 最小圆角 */
}

.tip.good { background: rgba(0,184,148,0.06); color: #00b894; }
.tip.bad { background: rgba(225,112,85,0.06); color: #e17055; }

/* ===== 5.5 底部操作栏 ===== */
/* 视觉重心靠下：主要操作在屏幕底部 1/3 */
.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  padding: 16rpx 24rpx; /* 二级留白 */
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.04);
  z-index: 100;
}

/* 两个次要按钮并排 */
.bottom-secondary {
  display: flex;
  gap: 16rpx; /* 三级留白 */
  margin-bottom: 16rpx; /* 三级留白 */
}

.bottom-btn-sm {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
}

/* 主按钮单独一行，宽度满屏 */
.bottom-btn-main {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.bottom-btn-main.disabled {
  background: #e0e0e0;
  color: #bbb;
  box-shadow: none;
}

.bottom-row {
  display: flex;
  gap: 16rpx;
}

.bottom-btn-back {
  padding: 0 40rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.flex-1 { flex: 1; }

/* ===== Step 2 模板页 ===== */
.tpl-page { padding-bottom: 240rpx; }

/* 4.3 横向风格导航条 — 高度 120rpx */
.style-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx; /* 三级留白 */
  height: 120rpx;
}

.style-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 22rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  position: relative;
  transition: all 0.3s;
}

.style-card.active {
  color: #FF6B9D;
  font-weight: 600;
  background: linear-gradient(135deg, rgba(255,107,157,0.1), rgba(196,79,226,0.1));
  box-shadow: 0 4rpx 12rpx rgba(255,107,157,0.15);
}

.style-emoji { font-size: 36rpx; }
.style-name { font-size: 22rpx; }

.style-active-line {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #FF6B9D;
}

/* 4.4 模板瀑布流 — 卡片圆角 24rpx */
.tpl-waterfall {
  display: flex;
  gap: 16rpx; /* 三级留白 */
  padding: 0 20rpx;
}

.tpl-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 三级留白 */
}

.tpl-card {
  background: #fff;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  transition: all 0.3s;
}

.tpl-card.selected {
  box-shadow: 0 0 0 4rpx #FF6B9D, 0 8rpx 24rpx rgba(255,107,157,0.3);
}

/* 图片圆角仅顶部 */
.tpl-img-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
}

.tpl-img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.tpl-col:nth-child(2) .tpl-img { height: 360rpx; }

.tpl-check-overlay {
  position: absolute;
  inset: 0;
  background: rgba(255,107,157,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tpl-check {
  width: 64rpx; /* 8的倍数 */
  height: 64rpx;
  background: #FF6B9D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255,107,157,0.5);
}

.tpl-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.tpl-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(6px);
  padding: 2rpx 10rpx;
  border-radius: 8rpx; /* 最小圆角 */
}

/* 信息区：紧密贴合图片 */
.tpl-info {
  padding: 14rpx 16rpx; /* 三级留白 */
}

.tpl-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  text-align: center;
}

/* ===== Step 3 生成中 ===== */
.generating {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.gen-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.gen-orbs {
  position: relative;
  width: 200rpx; /* 8的倍数 */
  height: 200rpx;
  margin-bottom: 48rpx; /* 一级留白 */
}

.orb {
  position: absolute;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.orb-1 {
  width: 200rpx; height: 200rpx; top: 0; left: 0;
  border-top-color: #FF6B9D;
  border-right-color: rgba(255,107,157,0.2);
  animation: orbSpin 2s linear infinite;
}

.orb-2 {
  width: 144rpx; height: 144rpx; top: 28rpx; left: 28rpx;
  border-bottom-color: #C44FE2;
  border-left-color: rgba(196,79,226,0.2);
  animation: orbSpin 1.5s linear infinite reverse;
}

.orb-3 {
  width: 96rpx; height: 96rpx; top: 52rpx; left: 52rpx;
  border-top-color: #6C5CE7;
  border-right-color: rgba(108,92,231,0.2);
  animation: orbSpin 1s linear infinite;
}

.orb-core {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 48rpx;
  animation: orbPulse 1.2s ease-in-out infinite;
}

@keyframes orbSpin { to { transform: rotate(360deg); } }
@keyframes orbPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.15); }
}

.gen-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx; /* 四级留白 */
}

.gen-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx; /* 一级留白 */
}

.gen-progress-wrap {
  width: 480rpx; /* 8的倍数 */
  display: flex;
  align-items: center;
  gap: 16rpx; /* 三级留白 */
  margin-bottom: 16rpx;
}

.gen-progress-bar {
  flex: 1;
  height: 8rpx; /* 8rpx 标准 */
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.gen-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B9D, #C44FE2);
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

.gen-pct {
  font-size: 24rpx;
  color: #FF6B9D;
  font-weight: 700;
  min-width: 56rpx;
}

.gen-tip {
  font-size: 22rpx;
  color: #ccc;
  margin-bottom: 64rpx; /* 间距 64rpx */
}

/* 订阅按钮 */
.gen-subscribe {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: rgba(255,107,157,0.08);
  border-radius: 48rpx; /* 胶囊形 */
  font-size: 24rpx;
  color: #FF6B9D;
  font-weight: 500;
}

.gen-sub-icon { font-size: 28rpx; }
