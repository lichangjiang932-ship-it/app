<!--components/nav-bar/nav-bar.wxml-->
<view class="nav-bar-wrap" style="padding-top: {{statusBarHeight}}px; background: {{bgColor}}; {{fixed ? 'position:fixed;top:0;left:0;right:0;z-index:999;' : ''}}">
  <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
    <!-- 左侧 -->
    <view class="nav-left" style="width: {{menuBtnRect.width + 16}}rpx;">
      <view wx:if="{{back}}" class="nav-back hover-opacity" bindtap="onBack">
        <text class="back-icon">‹</text>
      </view>
      <view wx:elif="{{home}}" class="nav-home hover-opacity" bindtap="onHome">
        <text class="home-icon">⌂</text>
      </view>
    </view>
    <!-- 标题 -->
    <view class="nav-center">
      <text class="nav-title {{titleGradient ? 'gradient-text' : ''}}" wx:if="{{title}}">{{title}}</text>
      <slot name="center"></slot>
    </view>
    <!-- 右侧 -->
    <view class="nav-right" style="width: {{menuBtnRect.width + 16}}rpx;">
      <slot name="right"></slot>
    </view>
  </view>
</view>
<!-- 占位 -->
<view wx:if="{{fixed && placeholder}}" class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
