/* components/skeleton/skeleton.wxss */
.sk-wrap { padding: 24rpx; }
.sk-section { margin-bottom: 24rpx; }

/* Banner */
.sk-banner { width: 100%; height: 340rpx; border-radius: 32rpx; }
.sk-dots { display: flex; justify-content: center; gap: 10rpx; margin-top: 16rpx; }
.sk-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #e8e8e8; }
.sk-dot:first-child { width: 36rpx; }

/* 金刚区 */
.sk-tools { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.sk-tool { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.sk-tool-icon { width: 96rpx; height: 96rpx; border-radius: 50%; }
.sk-tool-text { width: 60rpx; height: 24rpx; border-radius: 8rpx; }

/* 横向滚动 */
.sk-hscroll { display: flex; gap: 16rpx; overflow: hidden; }
.sk-hcard { width: 240rpx; height: 320rpx; border-radius: 24rpx; flex-shrink: 0; }

/* 瀑布流 */
.sk-waterfall { display: flex; gap: 16rpx; }
.sk-col { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }
.sk-wcard { border-radius: 24rpx; width: 100%; }

/* 列表 */
.sk-list { display: flex; flex-direction: column; gap: 20rpx; }
.sk-list-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; background: #fff; border-radius: 20rpx; }
.sk-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.sk-lines { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.sk-line { height: 24rpx; border-radius: 8rpx; }
.sk-line.short { width: 40%; }
