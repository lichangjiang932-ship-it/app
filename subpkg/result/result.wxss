/* subpkg/result/result.wxss */
/* 7.3 底部操作按钮组：圆角 40rpx */
.page { min-height: 100vh; background: #f5f5f7; padding-bottom: 60rpx; }

.hero { text-align: center; padding: 28rpx 0 20rpx; }
.hero-emoji { font-size: 64rpx; display: block; margin-bottom: 8rpx; }
.hero-title { display: block; font-size: 36rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 4rpx; }
.hero-desc { font-size: 24rpx; color: #999; }

/* 7.2 横向滑动区：高度 70vh */
.result-swiper {
  height: 70vh;
  margin: 0 24rpx;
  border-radius: 24rpx; /* 中圆角 */
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
}
.result-img { width: 100%; height: 100%; }

/* 缩略图 */
.thumbs { margin: 16rpx 24rpx 0; }
.thumb-scroll { white-space: nowrap; }
.thumb {
  display: inline-block;
  width: 110rpx; height: 110rpx;
  margin-right: 10rpx;
  border-radius: 16rpx; /* 小圆角 */
  overflow: hidden;
  border: 3rpx solid transparent;
  opacity: 0.5;
  transition: all 0.3s;
}
.thumb.active {
  border-color: #FF6B9D;
  opacity: 1;
  box-shadow: 0 4rpx 12rpx rgba(255,107,157,0.3);
}
.thumb image { width: 100%; height: 100%; }

/* 7.3 操作按钮：圆角 40rpx */
.actions { display: flex; gap: 12rpx; margin: 24rpx 24rpx 0; }
.act-btn {
  flex: 1;
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 22rpx 0;
  background: #fff;
  border-radius: 48rpx; /* 最大圆角 — 胶囊形按钮 */
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: none;
  line-height: normal;
}
.act-btn.primary {
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255,107,157,0.3);
}
.act-btn.share { background: #fff; }
.act-btn.share::after { border: none; }
.act-icon { font-size: 36rpx; }

/* 再做一次 / 换模板 */
.retry-row { display: flex; gap: 12rpx; margin: 20rpx 24rpx 0; }
.retry-btn {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 18rpx;
  background: #fff;
  border-radius: 24rpx; /* 中圆角 — 卡片级 */
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 推荐 */
.reco-section { margin: 32rpx 24rpx 0; }
.reco-title { font-size: 30rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.reco-scroll { white-space: nowrap; }
.reco-card {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  border-radius: 24rpx; /* 中圆角 */
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.reco-img { width: 200rpx; height: 270rpx; }
.reco-name { display: block; padding: 10rpx; font-size: 22rpx; color: #333; text-align: center; }

/* 水印位置（7.4）：右下角 16rpx */
/* 由后端或Canvas合成，此处仅展示样式定义 */
.watermark {
  position: absolute;
  bottom: 16rpx; right: 16rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  background: rgba(0,0,0,0.2);
  padding: 2rpx 10rpx;
  border-radius: 8rpx; /* 最小圆角 */
}

/* 加载 */
.loading-center { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 16rpx; }
.mini-spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #eee; border-top-color: #FF6B9D; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #999; }
