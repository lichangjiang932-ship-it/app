/* subpkg/detail/detail.wxss */
/* 视觉层次：圆角分层 48/32/24/16/8 */
.page { min-height: 100vh; background: #f5f5f7; padding-bottom: 180rpx; }

.preview-img { width: 100%; height: 800rpx; }

/* 信息卡：上移覆盖图片 */
.info-card {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0; /* 大圆角顶部 */
  padding: 32rpx; /* 二级留白近似 */
  position: relative;
  z-index: 1;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}

.info-top { display: flex; justify-content: space-between; align-items: flex-start; }

.info-name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.info-name { font-size: 38rpx; font-weight: 700; color: #1a1a2e; }
.info-tag { background: rgba(255,107,157,0.1); color: #FF6B9D; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; font-weight: 600; }

.info-desc { display: block; font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 12rpx; }
.info-stats { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #999; }
.dot { color: #ddd; }
.fav-btn { font-size: 44rpx; padding: 8rpx; }

/* 示例图：圆角 24rpx */
.examples { margin: 28rpx 24rpx 0; }
.ex-title { font-size: 30rpx; font-weight: 700; display: block; margin-bottom: 16rpx; }
.ex-scroll { white-space: nowrap; }
.ex-item {
  display: inline-block;
  width: 240rpx; height: 320rpx;
  margin-right: 14rpx;
  border-radius: 24rpx; /* 中圆角 */
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.ex-item image { width: 100%; height: 100%; }

/* 须知卡：圆角 24rpx */
.notice-card {
  margin: 28rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx; /* 卡片圆角 */
  padding: 28rpx;
}
.notice-title { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 16rpx; }
.notice-item { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; font-size: 26rpx; color: #666; }
.n-num {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(255,107,157,0.1); color: #FF6B9D;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(24px);
  padding: 20rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}
.price { display: flex; flex-direction: column; }
.price-label { font-size: 22rpx; color: #999; }
.price-val { font-size: 40rpx; font-weight: 700; color: #e17055; }
.price-val.free { color: #00b894; }

/* 按钮：48rpx 胶囊形 */
.go-btn {
  padding: 0 56rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; border-radius: 48rpx;
}
