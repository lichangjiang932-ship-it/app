/* subpkg/history/history.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
}

/* 加载 */
.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 作品网格 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}

.work-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
}

.work-img-wrap {
  position: relative;
}

.work-img {
  width: 100%;
  height: 340rpx;
  display: block;
  background: #f0f0f0;
}

.work-status {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}

.work-status.completed { background: rgba(0,184,148,0.85); }
.work-status.processing { background: rgba(255,107,157,0.85); }
.work-status.failed { background: rgba(225,112,85,0.85); }

.work-info {
  padding: 16rpx;
}

.work-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.work-time {
  font-size: 20rpx;
  color: #bbb;
}

.work-actions {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
}

.work-action {
  width: 52rpx;
  height: 52rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 8rpx;
}

.empty-emoji { font-size: 72rpx; margin-bottom: 8rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.empty-hint { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }

.empty-btn {
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  color: #fff;
  padding: 14rpx 48rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255,107,157,0.3);
}
