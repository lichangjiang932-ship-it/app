/* subpkg/favorites/favorites.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
}

.loading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 收藏网格 */
.fav-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}

.fav-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.fav-img-wrap {
  position: relative;
}

.fav-img {
  width: 100%;
  height: 340rpx;
  display: block;
  background: #f0f0f0;
}

.fav-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}

.fav-info {
  padding: 16rpx;
}

.fav-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 8rpx;
}

.empty-emoji { font-size: 72rpx; margin-bottom: 8rpx; }
.empty-text { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }
.empty-hint { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }

.empty-btn {
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  color: #fff;
  padding: 14rpx 48rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255,107,157,0.3);
}
