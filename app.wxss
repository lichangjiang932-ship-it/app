/**app.wxss**/
/* ===== 全局基础 ===== */
page {
  background: #f5f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1a1a2e;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  line-height: 1.5;
}

::-webkit-scrollbar { display: none; width: 0; height: 0; color: transparent; }

/* ===== 8rpx 基线网格间距系统 ===== */
/* 一级留白（大区块间）: 48rpx */
.gap-1 { margin-bottom: 48rpx; }
/* 二级留白（区块内卡片间）: 24rpx */
.gap-2 { margin-bottom: 24rpx; }
/* 三级留白（卡片内元素间）: 16rpx */
.gap-3 { margin-bottom: 16rpx; }
/* 四级留白（紧凑元素间）: 8rpx */
.gap-4 { margin-bottom: 8rpx; }

.container { padding: 0 24rpx; }
.container-wide { padding: 0 32rpx; }

/* ===== 安全区 ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== 文字溢出 ===== */
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ellipsis-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

/* ===== 圆角分层系统 ===== */
/* 最大圆角 48rpx — 主要按钮、弹窗顶部 */
.radius-xl { border-radius: 48rpx; }
/* 大圆角 32rpx — 轮播图、大容器 */
.radius-lg { border-radius: 32rpx; }
/* 中圆角 24rpx — 卡片 */
.radius-md { border-radius: 24rpx; }
/* 小圆角 16rpx — 照片网格项、小卡片 */
.radius-sm { border-radius: 16rpx; }
/* 最小圆角 8rpx — 标签 */
.radius-xs { border-radius: 8rpx; }
/* 圆形 50% — 头像、图标背景 */
.radius-full { border-radius: 50%; }

/* ===== 阴影分层系统 ===== */
/* 浮层（弹窗）— 最深 */
.shadow-float { box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1); }
/* 卡片悬浮 */
.shadow-card { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05); }
/* 卡片静止 */
.shadow-card-base { box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
/* 按钮阴影 */
.shadow-btn { box-shadow: 0 8rpx 28rpx rgba(255, 107, 157, 0.3); }

/* ===== 按钮系统 ===== */
/* 主按钮 — 胶囊形 48rpx */
.btn-gradient {
  background: linear-gradient(135deg, #FF6B9D 0%, #C44FE2 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 157, 0.3);
  transition: all 0.2s ease;
}
.btn-gradient::after { border: none; }
.btn-gradient.disabled {
  background: #e0e0e0;
  color: #bbb;
  box-shadow: none;
}

/* 次要按钮 — 圆角矩形 32rpx */
.btn-secondary {
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}
.btn-secondary::after { border: none; }

/* ===== 按压反馈 ===== */
.tap { opacity: 0.7; transform: scale(0.96); }
.tap-bg { background: rgba(0,0,0,0.05) !important; }
.hover-opacity { transition: opacity 0.15s; }
.hover-opacity:active { opacity: 0.5; }

/* ===== 骨架屏 ===== */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 37%, #f0f0f0 63%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.4s ease-in-out infinite;
}
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 旋转加载器 ===== */
.spinner {
  width: 40rpx; height: 40rpx;
  border: 4rpx solid #eee;
  border-top-color: #FF6B9D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== 渐变文字 ===== */
.gradient-text {
  background: linear-gradient(135deg, #FF6B9D, #C44FE2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ===== Tag 标签 — 8rpx ===== */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ===== 分割线 ===== */
.divider-1rpx {
  width: 100%;
  height: 1rpx;
  background: #f0f0f0;
}

/* ===== 图片占位（加载失败） ===== */
.img-placeholder {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 40rpx;
}

/* ===== 暗黑模式 ===== */
@media (prefers-color-scheme: dark) {
  page { background: #1a1a2e; }
}
